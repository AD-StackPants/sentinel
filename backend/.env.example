# Application / Server Configuration
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Jurisdiction & Region Configuration
DEFAULT_JURISDICTION_CITY="Zamboanga City"
DEFAULT_JURISDICTION_REGION="Zamboanga Peninsula"
DEFAULT_MAP_LATITUDE=6.9214
DEFAULT_MAP_LONGITUDE=122.0790
DEFAULT_MAP_ZOOM=12.5

# Snowflake / CoCo CLI Credentials
SNOWFLAKE_ACCOUNT=placeholder_account
SNOWFLAKE_USER=placeholder_user
SNOWFLAKE_PASSWORD=placeholder_password
SNOWFLAKE_DATABASE=SENTINEL_AI_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_CORTEX_MODEL=llama3-8b

# Twilio Credentials (SMS)
TWILIO_ACCOUNT_SID=placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# SMTP Credentials (Email)
SMTP_SERVER=smtp.placeholder.com
SMTP_PORT=587
SMTP_USER=placeholder_smtp_user
SMTP_PASSWORD=placeholder_smtp_password
SMTP_FROM_EMAIL=alerts@sentinelai.demo
